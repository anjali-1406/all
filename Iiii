from django.urls import path

from . import views


app_name = "profiles"


urlpatterns = [
    path(
        "edit/",
        views.ProfileUpdateView.as_view(),
        name="edit_profile"
    ),

    path(
        "<str:username>/",
        views.ProfileDetailView.as_view(),
        name="profile"
    ),

    path(
        "verify/",
        views.get_verified,
        name="get_verified"
    ),

    path(
        "verify/success/",
        views.verification_success,
        name="verification_success"
    ),
]
